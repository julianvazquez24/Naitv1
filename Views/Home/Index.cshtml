@{
    ViewData["Title"] = "Home";
}
<div class="text-center">
    @if (ViewBag.estaLogueado)
    {
        <div style="position: relative;">
            <div id="map" style="z-index:1; position: relative;"></div>

            @if (ViewBag.esAdmin)
            {
                <script type="text/javascript">
                    setTimeout(() => {
                        location.reload();
                    }, 10000);
                </script>

                @if (ViewBag.BadgeActividades != null && ViewBag.BadgeActividades > 0)
                {
                    <div class="badge bg-success text-white position-absolute"
                         style="top: 60px; right: 20px; z-index: 10; font-size: 1.3rem; padding: 10px 15px;">
                        @ViewBag.BadgeActividades
                    </div>
                }

            }

        </div>

        <script type="text/javascript">
            const ACTIVIDADES = @Html.Raw(Json.Serialize(ViewBag.actividades));
            const ES_ADMIN = @Html.Raw(Json.Serialize(ViewBag.esAdmin));
        </script>
        <script src="~/js/cargarMapa.js"></script>
    }
    else
    {
        <a href="/Sesion">Iniciar Sesion</a>
        <span>o</span>
        <a href="/Sesion/Registrarse">Registrarse</a>
        <span>o</span>
        <a href="/Sesion/RegistroAnfitrion">Registrate como anfitrion</a>
    }
</div>
